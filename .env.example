# Copy this file to `.env` and adjust as needed. `.env` is gitignored.

# ── Server ────────────────────────────────────────────────────────────────
# Port the server listens on.
PORT=8080
# Bind address. 0.0.0.0 lets a phone or TV on your Wi-Fi open the host or
# display screen. Use 127.0.0.1 for local-only.
HOST=0.0.0.0

# ── HTTPS (optional) ──────────────────────────────────────────────────────
# Plain HTTP over LAN is fine for this game. Enable TLS only if you need it.
# Generate dev certs with: npm run gen-cert  (writes to ./certs, which is gitignored)
TLS_ENABLED=false
TLS_CERT_PATH=certs/cert.pem
TLS_KEY_PATH=certs/key.pem
